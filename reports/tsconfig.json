{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "../pkg/reports",
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "types": [],
    "skipLibCheck": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ]
}