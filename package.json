{
  "name": "celestial-wasm",
  "version": "0.2.0",
  "private": true,
  "description": "Celestial astronomical core in WebAssembly with TypeScript SVG charts",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "geraldo-netto",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./pkg/celestial_wasm.d.ts", "default": "./pkg/celestial_wasm.js" },
    "./charts": { "types": "./pkg/charts/index.d.ts", "default": "./pkg/charts/index.js" },
    "./wasm": "./pkg/celestial_wasm_bg.wasm"
  },
  "files": [
    "pkg/", "core/", "wasm/", "tests/", "scripts/", "docs/",
    "charts/src/", "charts/tests/", "charts/examples/",
    "charts/tsconfig.json", "charts/README.md",
    "Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".cargo/config.toml",
    "LICENSE", "NOTICE", "THIRD-PARTY-NOTICES.txt", "*.md", "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "node scripts/wasm.mjs build",
    "build:charts": "node scripts/charts.mjs build",
    "test": "npm run test:core && npm run test:bindings && npm run test:charts && npm run docs:check && npm run licenses:check",
    "test:core": "node scripts/wasm.mjs core",
    "test:bindings": "node scripts/wasm.mjs bindings",
    "test:charts": "node scripts/charts.mjs test",
    "gallery": "node scripts/charts.mjs gallery",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "prepack": "node scripts/package.mjs",
    "postpack": "node scripts/package.mjs clean",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@types/node": "22.19.13",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
