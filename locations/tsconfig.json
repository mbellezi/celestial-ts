{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "../pkg/locations",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "skipLibCheck": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
